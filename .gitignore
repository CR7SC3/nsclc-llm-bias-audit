# Secrets and environment
.env
.env.local

# Python
venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# IDE
.vscode/
.DS_Store

# Raw GENIE BPC source files — data use agreement required, not redistributable
data/genie_bpc/

# Raw per-call result files (too numerous, stored in baseline/ checkpoints instead)
results/raw/*.json

# New baseline runs are 100-400MB per model, over GitHub's per-file limit.
# Generated notes and results are available upon reasonable request (see README).
# A small set of early pilot results already committed to history is unaffected.
results/baseline/*.json
results/baseline/*.jsonl
results/baseline/*.log
results/baseline/*.lock

# Ad hoc run logs, not needed for reproducibility
logs/

# Claude Code internal files
.claude/

# Manuscript build artifacts (source of truth is the .md)
*.docx
